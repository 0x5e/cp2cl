#!/bin/sh
#
# The root filesystem as flashed is 128 MB, because 128 MB is what has to travel
# over EDL and it holds everything this board needs: the program, its modules and
# the kernel it boots. The partition it is written to is userdata, measured in
# GiB on this board, and none of that space exists until the filesystem's block
# count covers it.
#
# The first boot after a flash therefore does one thing: grow the filesystem and
# reboot. Nothing else starts -- no Wi-Fi, no Bluetooth, no program -- because
# the boot ends here, three scripts in. The red LED blinks 200 ms on and 200 ms
# off while the growth runs; it is the longest stretch of a first boot with
# nothing on the network to watch, and the board has no console.
#
# /var/lib/rootfs-resized is the whole of "first". It is written to the filesystem
# being resized and synced before the reboot, so a board that has grown boots
# straight through, and an image flashed again carries no marker and resizes
# again.
#
# A growth that fails does not reboot: the marker stays unwritten, the rest of
# the boot runs, the log says why, and the next boot tries again. A loop of
# reboots and a board reachable over ssh are not worth trading for each other --
# there is no console and no button on this board.
#
# The growth is the online kind: the root is mounted, so resize2fs asks the
# kernel to add block groups through EXT4_IOC_RESIZE_FS. New groups are
# described in the blocks mke2fs reserved for exactly this --
# s_reserved_gdt_blocks, 63 of them, set by -E resize=16G in the defconfig: 2048
# groups, 16 GiB at 1 KiB blocks. The kernel grows no further than those blocks
# describe, so an image whose reservation covered less than its partition would
# end up short of the end rather than past it. With nothing left to describe it
# does not stop short: it converts the filesystem to meta_bg and grows, and
# meta_bg is a descriptor layout lk2nd cannot follow when it looks for the kernel
# on the next boot.

LOG=/var/log
MARKER=/var/lib/rootfs-resized

say() {
	[ -w "$LOG" ] && echo "resize:  $*" >> "$LOG/boot.log"
}

# `red:power`, named by the board's device tree. The blink is the kernel's timer
# trigger rather than a loop here: it keeps blinking while resize2fs holds this
# script, without a second process to schedule.
red_led() { ls -d /sys/class/leds/*red* 2>/dev/null | head -n 1; }

blink() {
	[ -n "$1" ] || return 0
	echo timer > "$1/trigger" 2>/dev/null
	echo 200 > "$1/delay_on" 2>/dev/null
	echo 200 > "$1/delay_off" 2>/dev/null
}

steady() {
	[ -n "$1" ] || return 0
	echo none > "$1/trigger" 2>/dev/null
	echo 1 > "$1/brightness" 2>/dev/null
}

start() {
	[ -e "$MARKER" ] && return 0

	# The ramdisk mounts the root partition by device node, so /proc/mounts
	# carries the node here and not the /dev/root the kernel would have used.
	dev=$(awk '$2 == "/" { print $1; exit }' /proc/mounts)
	case "$dev" in
	/dev/*) ;;
	*)
		echo "Resizing root filesystem: $dev is not a device node, skipped"
		say "skipped $dev"
		return 1
		;;
	esac

	led=$(red_led)
	blink "$led"

	out=$(resize2fs "$dev" 2>&1)
	if [ $? -ne 0 ]; then
		steady "$led"
		echo "Resizing root filesystem: resize2fs failed on $dev"
		printf '%s\n' "$out"
		say "failed $dev"
		return 1
	fi

	# "The filesystem on /dev/mmcblk0p27 is now 1048576 (1k) blocks long."
	echo "$(printf '%s\n' "$out" | tail -n 1)"
	say "grew $dev, rebooting"

	# The one line the growth printed, kept on the filesystem it describes: the
	# log it also went to is tmpfs and does not survive the reboot that follows.
	printf '%s\n' "$out" | tail -n 1 > "$MARKER"

	# Nothing has started yet -- this is the second script of the boot -- so
	# there is nothing to stop, and -f goes straight to the syscall instead of
	# signalling init, which would run rcK and unmount the filesystem this
	# script is still standing in.
	sync
	reboot -f
}

case "$1" in
	start) start ;;
	stop|restart|reload) ;;
	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
