#!/bin/sh
#
# The name this board goes by: `CarPlayBox` and the last four characters of
# wlan0's own address, e.g. `CarPlayBox-3F7B`.
#
# Two files carry a name and both are written here: /etc/hostname, which the boot
# applies before any script runs, and the access point's configuration, whose
# ssid= hostapd beacons. Everything else asks the kernel — the Bluetooth name,
# the name the phone lists, the name the car is given, the page.
#
# The address cannot be had any earlier: wlan0 appears only after wcnss_pil has
# loaded the firmware out of the modem partition, which is seconds into the boot
# on this board. So the first boot writes the answer and restarts; every boot
# after that finds it written and asks nothing.
#
# Where that address comes from is lk2nd: it patches local-mac-address into the
# WCNSS node before starting the kernel, from the one the stock firmware wrote to
# the persist partition. Without it the driver picks one at random, and the
# suffix changes every boot.

IFACE=wlan0
PREFIX=CarPlayBox
HOSTNAME_FILE=/etc/hostname
HOSTAPD_FILE=/etc/hostapd/hostapd.conf
LOG=/var/log

# The LEDs, by colour: the device tree names them led-r/led-g/led-b with
# function power/wlan/wan, and the class name is composed from both, so the
# colour is the part that can be matched without knowing the exact string.
red_led()   { ls -d /sys/class/leds/*red* 2>/dev/null | head -n 1; }
green_led() { ls -d /sys/class/leds/*green* 2>/dev/null | head -n 1; }

# 0.5 s a round, 20 s in all. The firmware load is what takes the time here, not
# the driver: wcnss_pil copies a few hundred KB into the remote processor and
# waits for it to boot.
ROUNDS=40

say() {
	[ -w "$LOG" ] && echo "name:    $*" >> "$LOG/boot.log"
}

# A board that is working on something should not look like one that is not.
red_blink() {
	led=$(red_led)
	[ -n "$led" ] || return 0
	echo timer > "$led/trigger" 2>/dev/null || return 0
	echo 200 > "$led/delay_on" 2>/dev/null
	echo 200 > "$led/delay_off" 2>/dev/null
}

red_steady() {
	led=$(red_led)
	[ -n "$led" ] || return 0
	echo none > "$led/trigger" 2>/dev/null
	echo 1 > "$led/brightness" 2>/dev/null
}

# The green one says the radio came up. It is set here because this is the first
# script that has an answer either way, and left on: S56led takes it over once
# the access point is on air.
green_on() {
	led=$(green_led)
	[ -n "$led" ] || return 0
	echo none > "$led/trigger" 2>/dev/null
	echo 1 > "$led/brightness" 2>/dev/null
}

start() {
	current=$(cat "$HOSTNAME_FILE" 2>/dev/null)
	case "$current" in
	"$PREFIX"-*)
		echo "Naming the board: $current (kept)"
		say "$current"
		green_on
		return 0
		;;
	esac

	# Everything below this line is a boot that has work to do and no program
	# to show for it yet.
	red_blink

	i=0
	while [ ! -r "/sys/class/net/$IFACE/address" ]; do
		i=$((i + 1))
		if [ "$i" -ge "$ROUNDS" ]; then
			echo "Naming the board: no $IFACE after 20 s, staying $PREFIX"
			say "$PREFIX radio_absent=true"
			red_steady
			return 0
		fi
		sleep 0.5
	done

	green_on

	hex=$(sed 's/://g' "/sys/class/net/$IFACE/address" 2>/dev/null)
	case "$hex" in
	????????????) ;;
	*)
		echo "Naming the board: $IFACE address unreadable, staying $PREFIX"
		say "$PREFIX address_unreadable=true"
		red_steady
		return 0
		;;
	esac
	name="$PREFIX-$(printf %s "$hex" | tail -c 4 | tr 'a-f' 'A-F')"

	echo "$name" > "$HOSTNAME_FILE"
	if [ "$(cat "$HOSTNAME_FILE" 2>/dev/null)" != "$name" ]; then
		echo "Naming the board: could not write $HOSTNAME_FILE"
		say "$name write_failed=true"
		red_steady
		return 1
	fi

	sed -i "s/^127\.0\.1\.1.*/127.0.1.1	$name/" /etc/hosts
	sed -i "s/^ssid=.*/ssid=$name/" "$HOSTAPD_FILE"

	echo "Naming the board: $name, restarting"
	say "$name"
	sync
	reboot
	say "$name restart_failed=true"
}

case "$1" in
	start) start ;;
	stop|restart|reload) ;;
	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
