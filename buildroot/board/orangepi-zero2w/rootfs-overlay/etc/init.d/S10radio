#!/bin/sh

MODDIR=/lib/modules/$(uname -r)
LOG=/var/log

# Order matters: the WCN core first, its two clients after.
MODULES="ecc ecdh_generic bluetooth hci_uart sunxi_addr uwe5622_bsp_sdio sprdwl_ng sprdbt_tty"

log() {
	echo "$*"
	[ -w "$LOG" ] && echo "$*" >> "$LOG/radio.log"
}

# sprdbt_tty registers blocked, and only an unblock powers the BT core.
unblock() {
	for r in /sys/class/rfkill/rfkill*; do
		[ "$(cat "$r/type" 2>/dev/null)" = "bluetooth" ] || continue
		echo 0 > "$r/soft" 2>>"$ERR" && log "unblocked $r"
	done
}

attach() {
	i=0
	while [ "$i" -lt 25 ]; do
		i=$((i + 1))
		if [ -c /dev/ttyBT0 ]; then
			break
		fi
		sleep 0.2
	done

	if [ ! -c /dev/ttyBT0 ]; then
		log "no /dev/ttyBT0 after 5 s"
		return 1
	fi

	hciattach_opi -n -s 1500000 /dev/ttyBT0 sprd >>"$ERR" 2>&1 &

	i=0
	while [ "$i" -lt 50 ]; do
		i=$((i + 1))
		if [ -e /sys/class/bluetooth/hci0 ]; then
			log "hci0 up on /dev/ttyBT0"
			return 0
		fi
		sleep 0.2
	done

	log "hciattach ran, no hci0 after 10 s"
	return 1
}

start() {
	printf 'Loading radios: '

	ERR=/dev/null
	[ -w "$LOG" ] && ERR=$LOG/radio.log

	failed=0
	for m in $MODULES; do
		ko=$(find "$MODDIR" -name "$m.ko" 2>/dev/null | head -n 1)
		if [ -z "$ko" ]; then
			log "missing $m.ko under $MODDIR"
			failed=1
			continue
		fi
		if insmod "$ko" 2>>"$ERR"; then
			log "loaded $ko"
		else
			log "insmod $ko failed"
			failed=1
		fi
	done

	if [ "$failed" = 1 ]; then
		echo "failed"
		return 1
	fi

	unblock
	sleep 1

	attach || true
	# hci0 has an rfkill of its own, registered blocked by what came before it.
	unblock
	echo "ok"
}

stop() {
	printf 'Unloading radios: '
	killall hciattach_opi 2>/dev/null
	for m in sprdbt_tty sprdwl_ng uwe5622_bsp_sdio hci_uart bluetooth ecdh_generic ecc; do
		rmmod "$m" 2>/dev/null
	done
	echo "ok"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
