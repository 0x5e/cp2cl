#!/bin/sh
#
# The 16 MiB SPI NOR at /persist. A first mke2fs takes about a minute, so it
# runs detached: the boot does not wait, and the program starts without it.

MTD=/dev/mtdblock0
MOUNT=/persist
LOG=/var/log
# Both lists are the paths everything else uses, and the volume keeps each at
# the same path under /persist.
FILES="/etc/cp2cl/config.json /etc/cp2cl/pairings.json"
DIRS="/var/lib/bluetooth /var/lib/lockdown"

log() {
	echo "spiflash: $*"
	[ -w "$LOG" ] && echo "spiflash: $*" >> "$LOG/boot.log"
}

# 0 ext4, 1 something else, 2 unreadable.
formatted() {
	magic=$(dd if="$MTD" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
	case "$magic" in
	53ef) return 0 ;;
	????) return 1 ;;
	esac
	return 2
}

# A file that moves onto the volume and leaves a link behind: one the program
# wrote on the card goes over, one on neither side starts as `{}`.
adopt_file() {
	card=$1
	store=$MOUNT$card
	mkdir -p "${store%/*}" || { log "${store%/*} could not be made"; return 1; }

	if [ ! -L "$card" ] && [ -f "$card" ]; then
		mv "$card" "$store" || { log "$card would not move to $store"; return 1; }
	elif [ ! -f "$store" ]; then
		printf '{}\n' > "$store" || { log "$store could not be written"; return 1; }
	fi

	ln -sfn "$store" "$card" && log "$card -> $store"
}

# A directory that moves onto the volume the same way. One that will not empty
# stays on the card with no link, because a link would hide what is in it.
adopt_dir() {
	card=$1
	store=$MOUNT$card
	mkdir -p -m 0700 "$store" || { log "$store could not be made"; return 1; }

	if [ -d "$card" ] && [ ! -L "$card" ]; then
		if [ -n "$(ls -A "$card" 2>/dev/null)" ]; then
			for p in "$card"/*; do
				[ -e "$p" ] || continue
				mv "$p" "$store"/ || { log "$p would not move to $store"; return 1; }
			done
		fi
		rmdir "$card" 2>/dev/null || { log "$card would not empty, left on the card"; return 1; }
	fi

	ln -sfn "$store" "$card" && log "$card -> $store"
}

# Nothing is mounted, so a link would name nothing. Remove the link, not what it
# points at, and let the writer use its own path on the card again.
unlink() {
	for f in $FILES; do
		[ -L "$f" ] && rm -f "$f"
	done
	for d in $DIRS; do
		[ -L "$d" ] || continue
		rm -f "$d"
		mkdir -p -m 0700 "$d"
	done
}

mount_all() {
	if ! mount -t ext4 -o rw,noatime "$MTD" "$MOUNT"; then
		log "$MTD would not mount on $MOUNT"
		unlink
		return 1
	fi

	for f in $FILES; do
		adopt_file "$f"
	done
	for d in $DIRS; do
		adopt_dir "$d"
	done
	log "mounted $MTD on $MOUNT"
}

start() {
	[ -b "$MTD" ] || { log "no $MTD, /proc/mtd is empty"; return 0; }

	mkdir -p "$MOUNT"

	formatted
	case $? in
	0) mount_all ;;
	1)
		# Out of the boot's way. The program runs with the files on the card
		# until this finishes, and writes through the links afterwards.
		log "$MTD carries no ext4, formatting detached"
		(
			mke2fs -q -t ext4 -b 4096 -L persist -m 0 "$MTD" || {
				log "mke2fs failed on $MTD"
				exit 1
			}
			mount_all
		) </dev/null >/dev/null 2>&1 &
		;;
	*)
		log "$MTD unreadable, left alone"
		unlink
		return 1
		;;
	esac
}

case "$1" in
	start) start ;;
	stop|restart|reload) ;;
	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
