CONFIG_MMC_SUNXI=y

# The 16 MiB SPI NOR on SPI0, as one whole-chip MTD device.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
# spi0 asks for its DMA channels in probe and defers for ever when the provider
# is a module nothing loads: arm64's defconfig has this one as =m.
CONFIG_DMA_SUN6I=y

CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN50I_H616=y

# USB_MUSB_SUNXI depends on these three; it does not select them.
CONFIG_USB_MUSB_HDRC=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_MUSB_SUNXI=y

CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_TIMER=y

CONFIG_BT_HCIUART=m
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_QCA is not set
CONFIG_BT_HCIUART_H4=y
CONFIG_SUNXI_ADDR_MGT=m

# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WWAN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_NETFILTER is not set
# CONFIG_IIO is not set
# CONFIG_SCSI_LOWLEVEL is not set

# CONFIG_BTRFS_FS is not set
