# Applied on top of U-Boot's own nanopi_duo2_defconfig.

# Two seconds of countdown, waiting for a key on a console this board does not
# have.
CONFIG_BOOTDELAY=0

# ARCH_SUNXI selects USE_PREBOOT, so preboot cannot be turned off, only emptied:
# its default is `usb start`, a scan of the USB controllers for boot media that
# might be a stick, and the boot media here is the card.
CONFIG_PREBOOT=""

# A host tool that signs UEFI capsules. EFI_LOADER is on in this configuration,
# so it is built by default — and on U-Boot 2025.01 it links gnutls, which
# nothing else in this image uses. Nothing here signs a capsule.
# CONFIG_TOOLS_MKEFICAPSULE is not set
