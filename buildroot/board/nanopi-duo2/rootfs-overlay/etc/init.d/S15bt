#!/bin/sh
#
# The Bluetooth stack, loaded from here rather than compiled in.
#
# A built-in btbcm probes at device_initcall, before the root is mounted:
# /lib/firmware/brcm/BCM43430A1.hcd is not there yet, the request fails with
# -ENOENT, and the controller is left unpatched. An unpatched BCM43430A1 then
# answers READ_BD_ADDR with AA:AA:AA:AA:AA:AA, which btbcm marks as an invalid
# address, and BlueZ builds /var/lib/bluetooth/AA:AA:AA:AA:AA:AA/ from it
# instead of the directory that holds the pairings. Loaded here, the patch file
# is on a root that has already been mounted.
#
# Everything goes to /var/log/bt.log, because "no adapter" and "adapter with no
# address" look the same from a phone.

MODDIR=/lib/modules/$(uname -r)
LOG=/var/log

# In the order modules.dep gives them, without the modprobe that would read it:
# the two crypto primitives the Bluetooth core links against, the core, the
# serial profile the phone's iAP2 rides on, the Broadcom patcher, the UART
# transport that uses it.
MODULES="ecc ecdh_generic bluetooth rfcomm btbcm hci_uart"

log() {
	echo "$*"
	[ -w "$LOG" ] && echo "$*" >> "$LOG/bt.log"
}

start() {
	printf 'Loading bluetooth: '
	ERR=/dev/null
	if [ -w "$LOG" ]; then
		: > "$LOG/bt.log"
		ERR=$LOG/bt.log
	fi

	for m in $MODULES; do
		ko=$(find "$MODDIR" -name "$m.ko" 2>/dev/null | head -n 1)
		if [ -z "$ko" ]; then
			log "missing $m.ko under $MODDIR"
			continue
		fi
		if insmod "$ko" 2>>"$ERR"; then
			log "loaded $ko"
		else
			log "insmod $ko failed"
		fi
	done

	# The controller appears once btbcm has pushed the patch, which is about
	# three seconds of 115200 baud. Twenty is a ceiling: if hci0 has not
	# appeared by then it is not going to, and the reason is in dmesg.
	if [ ! -d /sys/class/bluetooth ]; then
		log "/sys is not mounted: hci0 may exist and be invisible"
		dmesg | grep -i -E 'bluetooth|bcm|hci' >> "$ERR" 2>/dev/null
		echo "no /sys"
		return 1
	fi

	i=0
	while [ ! -e /sys/class/bluetooth/hci0 ]; do
		i=$((i + 1))
		if [ "$i" -gt 20 ]; then
			log "hci0 did not appear in 20 s"
			dmesg | grep -i -E 'bluetooth|bcm|hci' >> "$ERR" 2>/dev/null
			echo "no hci0"
			return 1
		fi
		sleep 1
	done

	# The two lines that say whether this boot got the address right: one is
	# printed when the patch went in, the other when it did not and the chip
	# fell back to its default.
	dmesg | grep -i -E 'BCM43430A1.*Patch|Using default device address' \
		>> "$ERR" 2>/dev/null

	log "hci0 appeared after ${i}s"
	echo "ok"
}

stop() {
	printf 'Unloading bluetooth: '
	for m in hci_uart btbcm rfcomm bluetooth ecdh_generic ecc; do
		rmmod "$m" 2>/dev/null
	done
	echo "ok"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
