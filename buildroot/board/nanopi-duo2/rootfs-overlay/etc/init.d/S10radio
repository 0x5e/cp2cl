#!/bin/sh
#
# Both radios, loaded from here rather than compiled in.
#
# A built-in driver probes at device_initcall, before the root is mounted, and
# /lib/firmware does not exist yet. brcmfmac's firmware request fails with
# -ENOENT and is not retried, so the SDIO function stays bound to a driver that
# never brought the chip up; btbcm's patch request fails the same way, and an
# unpatched BCM43430A1 answers READ_BD_ADDR with AA:AA:AA:AA:AA:AA, which btbcm
# marks invalid, so BlueZ builds /var/lib/bluetooth/AA:AA:AA:AA:AA:AA/ instead
# of the directory that holds the pairings.
#
# Nothing here waits for what it loaded: the interface appears once brcmfmac has
# taken its firmware and the controller once btbcm has pushed the patch, both a
# second or two later, and whether they did is the program's question — it waits
# for them itself and says so in its log. What is left here is the module list
# and a file for the case where one of them would not load.

MODDIR=/lib/modules/$(uname -r)
LOG=/var/log

# In the order the dependencies need, without the modprobe that would read them:
# brcmutil before brcmfmac, the two crypto primitives and the core before the
# serial profile, the Broadcom patcher before the transport that uses it.
MODULES="brcmutil brcmfmac ecc ecdh_generic bluetooth rfcomm btbcm hci_uart"

log() {
	echo "$*"
	[ -w "$LOG" ] && echo "$*" >> "$LOG/radio.log"
}

start() {
	printf 'Loading radios: '
	ERR=/dev/null
	if [ -w "$LOG" ]; then
		: > "$LOG/radio.log"
		ERR=$LOG/radio.log
	fi

	failed=0
	for m in $MODULES; do
		ko=$(find "$MODDIR" -name "$m.ko" 2>/dev/null | head -n 1)
		if [ -z "$ko" ]; then
			log "missing $m.ko under $MODDIR"
			failed=1
			continue
		fi
		if insmod "$ko" 2>>"$ERR"; then
			log "loaded $ko"
		else
			log "insmod $ko failed"
			failed=1
		fi
	done

	if [ "$failed" = 1 ]; then
		echo "failed"
		return 1
	fi
	echo "ok"
}

stop() {
	printf 'Unloading radios: '
	for m in hci_uart btbcm rfcomm bluetooth ecdh_generic ecc brcmfmac brcmutil; do
		rmmod "$m" 2>/dev/null
	done
	echo "ok"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
