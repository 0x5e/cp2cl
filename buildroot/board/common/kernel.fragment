# What every board in this tree needs, and nothing else.
#
# A defconfig is a distribution's idea of a kernel: HDMI, sound, USB host,
# storage, netfilter, every filesystem. What this program uses is a USB device
# controller, a radio, and the filesystem its root lives on. The rest is boot
# time and image size, so it is off — and it is off with the `is not set` form,
# because a fragment that says `CONFIG_X=n` is a line olddefconfig drops.

CONFIG_MODULES=y

# The gadget: configfs composes it, FunctionFS carries it. The controller itself
# is board-specific — musb on the NanoPi, ChipIdea on the UFI001C — and lives in
# each board's fragment.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

CONFIG_MMC=y

# Wi-Fi and Bluetooth. The stack above the bus is the same on all three boards;
# which driver binds to the chip, and whether it is a module, is the board
# fragment's business.
#
# The first two are menuconfigs, and a minimal vendor defconfig — sunxi's, for
# one — turns both off. With them off nothing underneath exists, and the lines
# below are not overridden but dropped: olddefconfig removes CFG80211, MAC80211
# and the driver without a word, the build succeeds, and the board comes up with
# no radio at all.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
# The core and the serial profile, shared by all three boards. The transport is
# board-specific: UART+btbcm on the NanoPi, SDIO+tty on the Zero 2W, rpmsg on the
# UFI001C.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m

CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_INET=y
# AirPlay is an IPv6 protocol: the receiver's listener is an AF_INET6 socket, and
# with IPv6 out of the kernel that bind fails with EAFNOSUPPORT and the program
# exits before it ever serves a page. sunxi_defconfig turns it off.
CONFIG_IPV6=y

# FAT, for the boot partition and for a USB stick: the one way to carry a file
# off a board whose network did not come up. sunxi_defconfig carries FAT_FS but
# not VFAT_FS, and the two are not the same thing.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_STORAGE is not set

# Not `# CONFIG_DEBUG_INFO is not set`: since 6.10 the symbol is a choice, and a
# fragment can pick an option of a choice but cannot unset one. The `is not set`
# form is dropped without a word and vmlinux keeps the DWARF the architecture's
# defconfig asked for — 166 MB against 53. Nothing that reaches the card
# changes, because Image is an objcopy of the loadable sections and the modules
# are installed stripped; what it buys is the build tree, at every rebuild.
CONFIG_DEBUG_INFO_NONE=y

# CONFIG_MODULE_SIG is not set
