# The root is a read-only squashfs; everything that is written lives in a tmpfs
# and is gone at power off. That is the trade the image makes: nothing to fsck
# on a card that loses power with the ignition.
#
# The four kernel filesystems are not optional, and leaving them out is silent:
# no /sys means no /sys/class/net, so a driver that bound perfectly well looks
# like a driver that never loaded — the first image of this board had a working
# radio and no wlan0 for exactly that reason. No devpts means dropbear takes the
# connection and then cannot allocate a terminal.
#
# /log is the one partition that is written: a FAT holding what the boot had to
# say about itself. It is a separate partition rather than a file on the boot one
# so that a card pulled mid-write cannot damage what U-Boot reads, and it is FAT
# so that it mounts on a laptop with the card in a reader.
/dev/root	/		squashfs	ro,noatime		0 0
proc		/proc		proc		defaults		0 0
sysfs		/sys		sysfs		defaults		0 0
devpts		/dev/pts	devpts		gid=5,mode=620		0 0
tmpfs		/dev/shm	tmpfs		mode=1777		0 0
tmpfs		/tmp		tmpfs		mode=1777		0 0
tmpfs		/run		tmpfs		mode=0755		0 0
tmpfs		/var/log	tmpfs		mode=0755,size=4M	0 0
/dev/mmcblk0p3	/log		vfat		rw,noatime,umask=0022	0 0
