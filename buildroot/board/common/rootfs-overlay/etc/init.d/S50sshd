#!/bin/sh
#
# sshd, for reaching the board over the access point while debugging.
#
# This replaces Buildroot's own S50sshd, and the only difference that matters is
# the line it does not have: `ssh-keygen -A`. That one generates whatever host
# keys are missing, and the root here is a read-only squashfs with nowhere to put
# them, so every boot would spend a moment failing to write keys it cannot have.
# The key it needs is in the image instead — see the ssh/ directory next to this
# one, and the sshd_config beside that.
#
# Everything else is Buildroot's script, so that start/stop behaves the way the
# rest of the system expects.

DAEMON="sshd"
PIDFILE="/var/run/$DAEMON.pid"

start() {
	printf "Starting %s: " "$DAEMON"
	start-stop-daemon --start --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
		return "$status"
	fi
	# sshd deletes its PID file on exit, wait for it to be gone
	while [ -f "$PIDFILE" ]; do
		sleep 0.1
	done
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	reload)
		printf "Reloading %s config: " "$DAEMON"
		start-stop-daemon --stop --signal HUP -q --pidfile "$PIDFILE" \
			--exec "/usr/sbin/$DAEMON"
		status=$?
		if [ "$status" -eq 0 ]; then
			echo "OK"
		else
			echo "FAIL"
		fi
		return "$status"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit $?
