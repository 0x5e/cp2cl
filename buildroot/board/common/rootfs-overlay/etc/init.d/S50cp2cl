#!/bin/sh
#
# cp2cl: nothing has to be behind it. The two radios are modules that `S10radio`
# loads and goes on, BlueZ is `S40bluetoothd`, and the access point is `S55ap`
# after it — the program waits for the three itself and says in its log what it
# was waiting for. What it reads out of /etc/hostapd is a file, not the daemon.
#
# The program needs no environment: every value it takes from outside is in
# /etc/cp2cl/config.json, which it creates itself out of the defaults, and so is
# the state it keeps — the identity it presents to the phone.
case "$1" in
	start)
		printf 'Starting cp2cl: '

		# The copy under /var/log is the program's own (`logging::Journal`):
		# the same lines without colour, at every level, rolled at 4 MiB.
		# A second, coloured copy of every line went into that same file
		# through this descriptor: the journal renames the file to `.1` as it
		# starts, and this one keeps writing the inode it was opened on, so
		# the escaped lines landed in the older chunk — which is the one the
		# download puts first. What is left for these two redirects is what
		# never reaches the layer: a panic, and whatever a library prints on
		# its own.
		setsid /usr/bin/cp2cl >/dev/null 2>>/var/log/cp2cl.err &
		echo $! > /run/cp2cl.pid
		echo "ok"
		;;
	stop)
		start-stop-daemon -K -q -p /run/cp2cl.pid
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
