#!/bin/sh
#
# cp2cl: what it needs is behind it — the two radios by `S10radio`, BlueZ by
# `S40bluetoothd` — and what is still ahead of it, the access point, it reads out
# of /etc/hostapd, which is a file rather than a daemon.
#
# The program has no settings file and needs no environment: every value it
# takes from outside has a default in it, and the state it keeps — the identity
# it presents to the phone — lives in /etc/cp2cl, which it creates itself.
case "$1" in
	start)
		printf 'Starting cp2cl: '

		# The copy under /var/log is the program's own (`logging::Journal`):
		# the same lines without colour, at every level, rolled at 4 MiB.
		# A second, coloured copy of every line went into that same file
		# through this descriptor: the journal renames the file to `.1` as it
		# starts, and this one keeps writing the inode it was opened on, so
		# the escaped lines landed in the older chunk — which is the one the
		# download puts first. What is left for these two redirects is what
		# never reaches the layer: a panic, and whatever a library prints on
		# its own.
		setsid /usr/bin/cp2cl >/dev/null 2>>/var/log/cp2cl.err &
		echo $! > /run/cp2cl.pid
		echo "ok"
		;;
	stop)
		start-stop-daemon -K -q -p /run/cp2cl.pid
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
