#!/bin/sh
#
# The wcnss image ships in this rootfs. The one thing still taken off the eMMC
# is the WLAN calibration blob, which is measured per board and cannot be
# carried by an image; it lives in `persist`. This is the loader that mounts
# that partition read-only, links the blob under the name the driver asks for,
# and points firmware_class.path at the directory holding it.
#
# It runs before S10radio, because qcom_wcnss_pil requests wcnss.mdt from probe
# and firmware_class reads its search path once per request: the path has to
# point at a directory with the blobs in it before the module is loaded.
#
# Nothing is copied. The links go into a tmpfs, the blob stays on its partition
# read-only, and the kernel is told to look there.

BASEDIR=/lib/firmware/msm-firmware-loader
LOG=/var/log

# The only partition read at boot. `modem` is left alone: the wcnss image that
# pairs an iPhone is in this rootfs, and nothing else on that partition has a
# reader here.
PARTITIONS="persist"

log() {
	echo "$*"
	[ -w "$LOG" ] && echo "firmware: $*" >> "$LOG/radio.log"
}

start() {
	printf 'Loading WCNSS firmware: '

	[ -d "$BASEDIR" ] || mkdir -p "$BASEDIR"
	mount -t tmpfs -o mode=755,nodev,noexec,nosuid none "$BASEDIR" || {
		echo "failed (mount)"
		return 1
	}
	mkdir -p "$BASEDIR/mnt" "$BASEDIR/target"

	# /dev/disk/by-partlabel does not exist here — no udev — so the names come
	# out of sysfs, one directory per partition.
	mounted=0
	for part in /sys/block/mmcblk*/mmcblk*p*; do
		[ -r "$part/uevent" ] || continue
		dev=$(sed -n 's/^DEVNAME=//p' "$part/uevent")
		name=$(sed -n 's/^PARTNAME=//p' "$part/uevent")
		[ -n "$name" ] || continue
		case " $PARTITIONS " in
		*" $name "*) ;;
		*) continue ;;
		esac
		mkdir -p "$BASEDIR/mnt/$name"
		if mount -o ro,nodev,noexec,nosuid "/dev/$dev" "$BASEDIR/mnt/$name"; then
			mounted=$((mounted + 1))
			log "mounted $name as /dev/$dev"
		else
			log "$name (/dev/$dev) would not mount"
		fi
	done

	# A GPT carries the names in /sys/.../uevent; an MBR table has none, and the
	# partition is then skipped without a word. The image still loads without it
	# -- that one is in the rootfs -- but wlan would come up uncalibrated.
	if [ "$mounted" = 0 ]; then
		log "no partition named one of: $PARTITIONS -- under /sys/block/mmcblk*"
	fi

	# The image built into the root filesystem. It is non-split, read whole, so
	# no fragments are needed beside it.
	if [ -f /lib/firmware/wcnss/wcnss.mdt ]; then
		ln -sf /lib/firmware/wcnss/wcnss.mdt "$BASEDIR/target/wcnss.mdt"
		log "wcnss image from the root filesystem"
	else
		log "no wcnss.mdt in the rootfs"
	fi

	# The NV blob is looked up as wlan/prima/WCNSS_qcom_wlan_nv.bin, which is the
	# name in drivers/soc/qcom/wcnss_ctrl.c.
	nv="$BASEDIR/mnt/persist/WCNSS_qcom_wlan_nv.bin"
	if [ -f "$nv" ]; then
		mkdir -p "$BASEDIR/target/wlan/prima"
		ln -sf "$nv" "$BASEDIR/target/wlan/prima/WCNSS_qcom_wlan_nv.bin"
	else
		log "no WCNSS_qcom_wlan_nv.bin on persist"
	fi

	# Some kernels ask for .mbn where the image is named .mdt. One link each.
	for mdt in "$BASEDIR"/target/*.mdt; do
		[ -e "$mdt" ] || continue
		ln -sf "$mdt" "${mdt%.mdt}.mbn"
	done

	printf '%s' "$BASEDIR/target" > /sys/module/firmware_class/parameters/path

	echo "ok"
}

case "$1" in
	start) start ;;
	stop|restart|reload) ;;
	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
