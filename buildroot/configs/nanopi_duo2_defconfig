# NanoPi Duo2 — Allwinner H3, 512 MB, AP6212 (2.4 GHz 1x1 + BCM43430 Bluetooth).
#
# Three values here are the vendor's and cannot be guessed: the kernel and
# U-Boot repositories, and the U-Boot board name. Everything else is the shape
# every board in this tree shares; what is specific to this one lives in
# board/nanopi-duo2/ and is pulled in below.
#
# The target is a read-only squashfs with nothing to fsck and no udev: the board
# loses power with the ignition, and a filesystem check on the next boot is a
# boot that does not finish.

BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

BR2_TARGET_GENERIC_HOSTNAME="nanopi-duo2"
BR2_TARGET_GENERIC_ISSUE="cp2cl"
BR2_TARGET_GENERIC_GETTY_PORT=""
BR2_SYSTEM_DHCP=""

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_TAR=n

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="TODO: FriendlyElec 的 4.14 BSP 仓库"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="TODO: 分支或 tag，例如 4.14.111"
BR2_LINUX_KERNEL_DEFCONFIG="sunxi_defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CP2CL_PATH)/board/common/kernel.fragment $(BR2_EXTERNAL_CP2CL_PATH)/board/nanopi-duo2/kernel.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sun8i-h3-nanopi-duo2"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="TODO: FriendlyElec 的 U-Boot 仓库"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="TODO: 分支或 tag"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="nanopi_duo2"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_BOOT_SCRIPT=y
BR2_TARGET_UBOOT_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_CP2CL_PATH)/board/nanopi-duo2/boot.cmd"

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_CP2CL=y
BR2_PACKAGE_HOST_GENIMAGE=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CP2CL_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_CP2CL_PATH)/board/nanopi-duo2/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CP2CL_PATH)/board/nanopi-duo2/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CP2CL_PATH)/board/nanopi-duo2/post-image.sh"
