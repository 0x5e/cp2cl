From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gaosen <0x5e@sina.cn>
Date: Sun, 1 Nov 2026 13:20:00 +0800
Subject: [PATCH 3/4] fix(bringup): let a session leave now playing out

A phone answers StartNowPlayingUpdates over the channel that asked, and on
Bluetooth that is the same link CarPlay is being brought up on. The cover art
alone is 115 KB: in one measured connection the phone took 16 s between being
handed the Wi-Fi credentials and answering `CarPlayAvailability`, and the cover
arrived at the end of that gap. Over Wi-Fi the same image takes 129 ms.

So the subscription is the session's to make. `CpConfig` gains `now_playing`,
answered `true` everywhere it was not thought about — the field is what the
existing behaviour became — and a caller that knows its channel is about to be
abandoned answers `false`. That session is then the one that does not ask, and
the session that follows on Wi-Fi asks for itself.
---

diff --git a/native/crates/livi-runtime/src/bringup.rs b/native/crates/livi-runtime/src/bringup.rs
--- a/native/crates/livi-runtime/src/bringup.rs
+++ b/native/crates/livi-runtime/src/bringup.rs
@@ -45,6 +45,15 @@
     pub on_cable: Option<OnCable>,
     pub start_again: Option<Arc<Notify>>,
     pub theme: Option<Theme>,
+    /// Whether this session is the one the phone's media should arrive on.
+    ///
+    /// Asked once, at bring-up, and only ever answered `false` on a channel
+    /// the phone is about to leave: an iPhone sends a subscription's traffic
+    /// over the link it was subscribed on, so on Bluetooth a cover — a hundred
+    /// kilobytes of it — queues ahead of the phone's own move to Wi-Fi and is
+    /// carried over the same antenna the access point is on. The session that
+    /// follows on Wi-Fi subscribes for itself.
+    pub now_playing: bool,
 }
 
 pub type AskOnAir = fn() -> Option<OnAir>;
@@ -96,27 +105,32 @@
 
 impl std::error::Error for BringupError {}
 
-fn subscriptions() -> Vec<Vec<u8>> {
-    vec![
-        StartNowPlayingUpdates {
-            media_item_attributes: Some(StartMediaItemAttributes {
-                persistent_id: false,
-                title: true,
-                duration_ms: true,
-                album: true,
-                artist: true,
-                album_artist: false,
-                genre: false,
-                artwork: true,
-            }),
-            playback_attributes: Some(StartPlaybackAttributes {
-                status: true,
-                elapsed_ms: true,
-                app_name: true,
-                app_bundle_id: false,
-            }),
-        }
-        .encode(),
+fn subscriptions(now_playing: bool) -> Vec<Vec<u8>> {
+    let mut subs = Vec::new();
+    if now_playing {
+        subs.push(
+            StartNowPlayingUpdates {
+                media_item_attributes: Some(StartMediaItemAttributes {
+                    persistent_id: false,
+                    title: true,
+                    duration_ms: true,
+                    album: true,
+                    artist: true,
+                    album_artist: false,
+                    genre: false,
+                    artwork: true,
+                }),
+                playback_attributes: Some(StartPlaybackAttributes {
+                    status: true,
+                    elapsed_ms: true,
+                    app_name: true,
+                    app_bundle_id: false,
+                }),
+            }
+            .encode(),
+        );
+    }
+    subs.extend([
         StartRouteGuidanceUpdates {
             display_component_id: None,
         }
@@ -153,7 +167,8 @@
             start_timestamp: false,
         }
         .encode(),
-    ]
+    ]);
+    subs
 }
 
 async fn recv<C: ControlChannel>(ch: &mut C) -> Result<Vec<u8>, BringupError> {
@@ -440,7 +455,7 @@
         }
     }
 
-    for sub in subscriptions() {
+    for sub in subscriptions(cp.now_playing) {
         if ch.send(sub).await.is_err() {
             let _ = events.send(BringupEvent::Closed).await;
             return;
@@ -785,6 +800,7 @@
             on_cable: None,
             start_again: None,
             theme: None,
+            now_playing: true,
         }
     }
 
