target/
Cargo.lock.orig

# The guide's screenshots are what the coded streams were built from, not what
# anyone needs: `guide/build.sh` takes them again from `guide/index.html`. The
# WebKit home it renders into goes beside them for the same reason.
guide/shots/
guide/.tmp/

# Credentials — private keys, never commit these. The cp2cl package installs the
# MFi pair into the firmware's /etc/cp2cl/ and the program reads them there; the
# CarLife key is put into the binary at build time from `CARLIFE_PRIVATE_KEY`.
# A clone without any of them builds and runs, just without authentication.
authentication/
*.pk8
*.p7b
*.p12

.DS_Store
.workbuddy/
.workbuddy-ai/

# The firmware image's inputs and outputs. The external tree under buildroot/ is
# source and is tracked; what Buildroot downloads and builds is not. The last one
# is not a build product at all: it is where a runner stages the download cache
# it carries between runs, and nothing on this machine writes there.
buildroot/output/
buildroot/dl/
.buildroot-dl/
dist/
