target/
Cargo.lock.orig

# The guide's screenshots are what the coded streams were built from, not what
# anyone needs: `scripts/guide.sh` takes them again from `guide/index.html`. The
# WebKit home it renders into goes beside them for the same reason.
guide/shots/
guide/.tmp/

# Credentials — private keys, never commit these. The cp2cl package installs them
# into the firmware's /etc/cp2cl/ and the program reads them there, so a clone
# without them builds and runs, just without authentication.
authentication/
*.pk8
*.p7b
*.p12

.DS_Store
.workbuddy/
.workbuddy-ai/

# The firmware image's inputs and outputs. The external tree under buildroot/ is
# source and is tracked; what Buildroot downloads and builds is not.
buildroot/output/
buildroot/dl/
dist/
